@echo off
setlocal EnableExtensions EnableDelayedExpansion
cd /d "%~dp0"
setlocal enabledelayedexpansion
title DevOptimizer Script Generator v4.0
color 0A

echo.
echo 
echo                                                               
echo      DEVOPTIMIZER SCRIPT GENERATOR v4.0                     
echo          Easy Creation of New Scripts and BAT Files          
echo                                                               
echo 
echo.

:: Load configuration
if exist "..\config\system-config.json" (
echo  Configuration loaded
) else (
echo   Configuration not found - using defaults
)

echo  SCRIPT GENERATION WIZARD
echo ============================
echo.

:: Get script details from user
echo Please provide the following information:
echo.

set /p "SCRIPT_NAME=Script Name (no spaces, use hyphens): "
if "%SCRIPT_NAME%"=="" (
echo  Script name is required!
pause
exit /b 1
)

echo.
echo Available Categories:
echo   1) system           - System Optimization
echo   2) development      - Development Tools
echo   3) optimization     - Performance Optimization
echo   4) maintenance      - System Maintenance
echo   5) ai-tools         - AI ^& ML Tools
echo   6) gaming           - Gaming ^& Streaming
echo   7) networking       - Network Optimization
echo   8) security         - Security ^& Privacy
echo   9) utilities        - General Utilities
echo.
set /p "CATEGORY_NUM=Select category (1-9): "

:: Map category number to name
if "%CATEGORY_NUM%"=="1" set "CATEGORY=system"
if "%CATEGORY_NUM%"=="2" set "CATEGORY=development"
if "%CATEGORY_NUM%"=="3" set "CATEGORY=optimization"
if "%CATEGORY_NUM%"=="4" set "CATEGORY=maintenance"
if "%CATEGORY_NUM%"=="5" set "CATEGORY=ai-tools"
if "%CATEGORY_NUM%"=="6" set "CATEGORY=gaming"
if "%CATEGORY_NUM%"=="7" set "CATEGORY=networking"
if "%CATEGORY_NUM%"=="8" set "CATEGORY=security"
if "%CATEGORY_NUM%"=="9" set "CATEGORY=utilities"

if "%CATEGORY%"=="" (
echo  Invalid category selection!
pause
exit /b 1
)

echo.
set /p "DESCRIPTION=Brief description: "
if "%DESCRIPTION%"=="" set "DESCRIPTION=Auto-generated script"

echo.
echo Script Types:
echo   1) BAT - Batch file (.bat)
echo   2) PS1 - PowerShell script (.ps1)
echo   3) BOTH - Both BAT launcher and PowerShell core
echo.
set /p "SCRIPT_TYPE=Select type (1-3): "

echo.
set /p "REQUIRES_ADMIN=Requires admin privileges? (y/N): "
if /i "%REQUIRES_ADMIN%"=="y" (
set "ADMIN_REQUIRED=true"
) else (
set "ADMIN_REQUIRED=false"
)

:: Generate timestamp
for /f "tokens=2 delims==" %%a in ('wmic OS Get localdatetime /value') do set "dt=%%a"
set "TIMESTAMP=%dt:~0,4%-%dt:~4,2%-%dt:~6,2% %dt:~8,2%:%dt:~10,2%:%dt:~12,2%"

echo.
echo  GENERATING SCRIPT...
echo =======================
echo.

:: Create directory structure
if not exist "..\categories\%CATEGORY%" (
mkdir "..\categories\%CATEGORY%"
echo  Created category directory: %CATEGORY%
)

:: Generate BAT file
if "%SCRIPT_TYPE%"=="1" or "%SCRIPT_TYPE%"=="3" (
set "BAT_FILE=..\categories\%CATEGORY%\%SCRIPT_NAME%.bat"

echo Creating BAT file: !BAT_FILE!

> "!BAT_FILE!" (
echo @echo off
setlocal EnableExtensions EnableDelayedExpansion
cd /d "%~dp0"
echo setlocal enabledelayedexpansion
echo title %SCRIPT_NAME% - %DESCRIPTION%
echo color 0B
echo.
echo REM =====================================================
echo REM %SCRIPT_NAME%.bat - %DESCRIPTION%
echo REM Generated by DevOptimizer Script Generator v4.0
echo REM Created: %TIMESTAMP%
echo REM Category: %CATEGORY%
echo REM Requires Admin: %ADMIN_REQUIRED%
echo REM =====================================================
echo.
echo echo.
echo echo 
echo echo                                                               
echo echo      %SCRIPT_NAME% - %DESCRIPTION%                          
echo echo                                                               
echo echo 
echo echo.
echo.
if "%ADMIN_REQUIRED%"=="true" (
echo REM Check for administrator privileges
echo net session ^>nul 2^>^&1
echo if %%errorLevel%% neq 0 ^(
echo     echo  This script requires Administrator privileges!
echo     echo Right-click and select "Run as administrator"
echo     echo.
echo     pause
echo     exit /b 1
echo ^)
echo echo  Administrator privileges confirmed
echo echo.
)
echo.
echo REM =====================================================
echo REM MAIN SCRIPT LOGIC - CUSTOMIZE BELOW
echo REM =====================================================
echo.
echo echo  Starting %SCRIPT_NAME%...
echo echo.
echo.
echo REM TODO: Add your script logic here
echo echo   This is a template script - please customize it!
echo echo.
echo echo Example operations:
echo echo   - System configurations
echo echo   - File operations
echo echo   - Registry modifications
echo echo   - Service management
echo echo.
echo.
echo REM =====================================================
echo REM COMPLETION AND CLEANUP
echo REM =====================================================
echo.
echo echo  %SCRIPT_NAME% completed successfully!
echo echo.
echo echo Press any key to exit...
echo pause ^>nul
echo.
echo endlocal
)

echo  BAT file created: !BAT_FILE!
)

:: Generate PowerShell file
if "%SCRIPT_TYPE%"=="2" or "%SCRIPT_TYPE%"=="3" (
set "PS1_FILE=..\categories\%CATEGORY%\%SCRIPT_NAME%.ps1"

echo Creating PowerShell file: !PS1_FILE!

> "!PS1_FILE!" (
echo # =====================================================
echo # %SCRIPT_NAME%.ps1 - %DESCRIPTION%
echo # Generated by DevOptimizer Script Generator v4.0
echo # Created: %TIMESTAMP%
echo # Category: %CATEGORY%
echo # Requires Admin: %ADMIN_REQUIRED%
echo # =====================================================
echo.
echo param^(
echo     [Parameter^(Mandatory=$false^)]
echo     [switch]$Silent,
echo
echo     [Parameter^(Mandatory=$false^)]
echo     [switch]$Debug
echo ^)
echo.
echo # Set up logging
echo $logPath = "..\..\logs\%SCRIPT_NAME%_$(Get-Date -Format 'yyyyMMdd_HHmmss'^).log"
echo.
echo function Write-Log {
echo     param^([string]$Message, [string]$Level = "INFO"^)
echo     $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
echo     $logEntry = "$timestamp - [$Level] $Message"
echo     Add-Content -Path $logPath -Value $logEntry
echo     if ^(!$Silent^) {
echo         switch ^($Level^) {
echo             "ERROR" { Write-Host $logEntry -ForegroundColor Red }
echo             "WARNING" { Write-Host $logEntry -ForegroundColor Yellow }
echo             "SUCCESS" { Write-Host $logEntry -ForegroundColor Green }
echo             "INFO" { Write-Host $logEntry -ForegroundColor Cyan }
echo             default { Write-Host $logEntry }
echo         }
echo     }
echo }
echo.
if "%ADMIN_REQUIRED%"=="true" (
echo # Check for administrator privileges
echo function Test-Administrator {
echo     $currentUser = [Security.Principal.WindowsIdentity]::GetCurrent^(^)
echo     $principal = New-Object Security.Principal.WindowsPrincipal^($currentUser^)
echo     return $principal.IsInRole^([Security.Principal.WindowsBuiltInRole]::Administrator^)
echo }
echo.
echo if ^(^!^(Test-Administrator^)^) {
echo     Write-Log "This script requires Administrator privileges!" "ERROR"
echo     exit 1
echo }
echo.
echo Write-Log "Administrator privileges confirmed" "SUCCESS"
)
echo.
echo # =====================================================
echo # MAIN SCRIPT LOGIC - CUSTOMIZE BELOW
echo # =====================================================
echo.
echo Write-Host "`n %SCRIPT_NAME% - %DESCRIPTION%" -ForegroundColor Cyan
echo Write-Host "=" * 60 -ForegroundColor Cyan
echo Write-Host ""
echo.
echo Write-Log "Starting %SCRIPT_NAME%" "INFO"
echo.
echo try {
echo     # TODO: Add your PowerShell logic here
echo     Write-Log "This is a template script - please customize it!" "WARNING"
echo
echo     Write-Host "Example operations:" -ForegroundColor Yellow
echo     Write-Host "  - Advanced system configurations" -ForegroundColor Gray
echo     Write-Host "  - WMI operations" -ForegroundColor Gray
echo     Write-Host "  - Registry modifications" -ForegroundColor Gray
echo     Write-Host "  - Service management" -ForegroundColor Gray
echo     Write-Host "  - File system operations" -ForegroundColor Gray
echo     Write-Host ""
echo
echo     Write-Log "%SCRIPT_NAME% completed successfully" "SUCCESS"
echo }
echo catch {
echo     Write-Log "Error in %SCRIPT_NAME%: $^($_.Exception.Message^)" "ERROR"
echo     exit 1
echo }
echo.
echo Write-Host "`n %SCRIPT_NAME% completed!" -ForegroundColor Green
)

echo  PowerShell file created: !PS1_FILE!
)

:: Update script registry
echo.
echo  Updating script registry...
powershell -Command "try { $registryPath = '..\registry\script-registry.json'; if (Test-Path $registryPath) { $registry = Get-Content $registryPath | ConvertFrom-Json; if (!$registry.scriptRegistry.scripts) { $registry.scriptRegistry.scripts = @{} }; $registry.scriptRegistry.scripts.'%SCRIPT_NAME%' = @{ name = '%SCRIPT_NAME%'; description = '%DESCRIPTION%'; category = '%CATEGORY%'; requiresAdmin = [bool]'%ADMIN_REQUIRED%'; created = '$(Get-Date)'; type = '%SCRIPT_TYPE%'; path = 'categories\%CATEGORY%\%SCRIPT_NAME%' }; $registry.scriptRegistry.totalScripts = ($registry.scriptRegistry.scripts | Get-Member -MemberType NoteProperty).Count; $registry | ConvertTo-Json -Depth 5 | Out-File -FilePath $registryPath -Encoding UTF8; Write-Host ' Script registered successfully' } else { Write-Host '  Registry file not found' } } catch { Write-Host ' Failed to update registry: ' $_.Exception.Message }"

echo.
echo  SCRIPT GENERATION COMPLETED!
echo ===============================
echo.
echo Script Details:
echo   Name: %SCRIPT_NAME%
echo   Category: %CATEGORY%
echo   Description: %DESCRIPTION%
echo   Requires Admin: %ADMIN_REQUIRED%
echo   Type: %SCRIPT_TYPE%
echo.

if "%SCRIPT_TYPE%"=="1" or "%SCRIPT_TYPE%"=="3" (
echo   BAT File: categories\%CATEGORY%\%SCRIPT_NAME%.bat
)
if "%SCRIPT_TYPE%"=="2" or "%SCRIPT_TYPE%"=="3" (
echo   PowerShell File: categories\%CATEGORY%\%SCRIPT_NAME%.ps1
)

echo.
echo  NEXT STEPS:
echo   1. Edit the generated file(s) to add your custom logic
echo   2. Test the script to ensure it works correctly
echo   3. Run the menu generator to update system menus
echo   4. Consider creating documentation for complex scripts
echo.

echo Would you like to:
echo   1) Generate another script
echo   2) Open the created file(s) for editing
echo   3) Exit generator
echo.
set /p "NEXT_ACTION=Select option (1-3): "

if "%NEXT_ACTION%"=="1" (
echo.
echo Restarting generator...
goto :EOF
call "%~f0"
)
if "%NEXT_ACTION%"=="2" (
if "%SCRIPT_TYPE%"=="1" or "%SCRIPT_TYPE%"=="3" (
if exist "..\categories\%CATEGORY%\%SCRIPT_NAME%.bat" (
notepad "..\categories\%CATEGORY%\%SCRIPT_NAME%.bat"
)
)
if "%SCRIPT_TYPE%"=="2" or "%SCRIPT_TYPE%"=="3" (
if exist "..\categories\%CATEGORY%\%SCRIPT_NAME%.ps1" (
notepad "..\categories\%CATEGORY%\%SCRIPT_NAME%.ps1"
)
)
)

echo.
echo Thank you for using DevOptimizer Script Generator! 
echo.
pause

endlocal
