{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://devoptimizer.local/schemas/hub-registry.schema.json",
    "title": "DevOptimizer Hub Registry Schema",
    "description": "Schema for the DevOptimizer Unified Script Hub registry file",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "version",
        "generated",
        "commands",
        "categories"
    ],
    "properties": {
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Semantic version of the registry format"
        },
        "generated": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp when the registry was generated"
        },
        "commands": {
            "type": "array",
            "description": "List of registered commands/scripts",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "name",
                    "category",
                    "path",
                    "description",
                    "parameters",
                    "requiresAdmin",
                    "tags",
                    "entryPoint",
                    "metadata"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "pattern": "^[a-z0-9-]+$",
                        "description": "Unique command identifier (kebab-case)"
                    },
                    "category": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Category name matching categories.json"
                    },
                    "path": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Relative path to the script file from repo root"
                    },
                    "description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500,
                        "description": "Human-readable description of the command"
                    },
                    "parameters": {
                        "type": "array",
                        "description": "Command parameters definition",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "name",
                                "type",
                                "description",
                                "required"
                            ],
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "minLength": 1,
                                    "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
                                    "description": "Parameter name"
                                },
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "string",
                                        "number",
                                        "boolean",
                                        "array",
                                        "object"
                                    ],
                                    "description": "Parameter data type"
                                },
                                "description": {
                                    "type": "string",
                                    "minLength": 1,
                                    "description": "Parameter description"
                                },
                                "required": {
                                    "type": "boolean",
                                    "description": "Whether the parameter is required"
                                },
                                "default": {
                                    "description": "Default value for optional parameters"
                                },
                                "enum": {
                                    "type": "array",
                                    "description": "Allowed values for enum types"
                                },
                                "minLength": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "Minimum string/array length"
                                },
                                "maxLength": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "Maximum string/array length"
                                },
                                "minimum": {
                                    "type": "number",
                                    "description": "Minimum numeric value"
                                },
                                "maximum": {
                                    "type": "number",
                                    "description": "Maximum numeric value"
                                }
                            }
                        }
                    },
                    "requiresAdmin": {
                        "type": "boolean",
                        "description": "Whether the command requires administrator privileges"
                    },
                    "tags": {
                        "type": "array",
                        "description": "Searchable tags for the command",
                        "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 50
                        },
                        "uniqueItems": true
                    },
                    "entryPoint": {
                        "type": "string",
                        "enum": [
                            "powershell",
                            "cmd",
                            "bash",
                            "python",
                            "node",
                            "wsl"
                        ],
                        "description": "Script interpreter/execution environment"
                    },
                    "metadata": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "author",
                            "created",
                            "modified",
                            "version",
                            "sourceUrl"
                        ],
                        "properties": {
                            "author": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Script author name or handle"
                            },
                            "created": {
                                "type": "string",
                                "format": "date-time",
                                "description": "ISO 8601 creation timestamp"
                            },
                            "modified": {
                                "type": "string",
                                "format": "date-time",
                                "description": "ISO 8601 last modification timestamp"
                            },
                            "version": {
                                "type": "string",
                                "pattern": "^\\d+\\.\\d+\\.\\d+$",
                                "description": "Script semantic version"
                            },
                            "sourceUrl": {
                                "type": "string",
                                "format": "uri",
                                "description": "URL to source repository or documentation"
                            },
                            "license": {
                                "type": "string",
                                "description": "SPDX license identifier"
                            },
                            "dependencies": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "External dependencies required"
                            },
                            "testedOn": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Platforms/OS versions tested on"
                            }
                        }
                    }
                }
            }
        },
        "categories": {
            "type": "array",
            "description": "Category summary with command counts",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "name",
                    "commandCount",
                    "lastUpdated"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Category name matching categories.json"
                    },
                    "commandCount": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Number of commands in this category"
                    },
                    "lastUpdated": {
                        "type": "string",
                        "format": "date-time",
                        "description": "ISO 8601 timestamp of last command addition/modification in this category"
                    }
                }
            }
        }
    }
}