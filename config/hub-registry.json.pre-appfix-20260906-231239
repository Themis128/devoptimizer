{"created":"2025-10-05T13:53:19.9612875+03:00","sourceUrl":"https://github.com/devoptimizer/devoptimizer","version":"1.0.0","author":"Unknown","modified":"2025-10-05T13:53:19.9612875+03:00"},"category":"utilities","description":"No description available","name":"ollama-batch-helper","requiresAdmin":false,"entryPoint":"cmd"},{"parameters":[{"description":"Port to bind the server to.","name":"Port","type":"string","required":false},{"description":"Starting port number.","name":"BasePort","type":"string","required":false}],"path":"tools/ollama-server-manager.ps1","tags":[],"metadata":{"created":"2025-10-04T14:11:06.7589516+03:00","sourceUrl":"https://github.com/devoptimizer/devoptimizer","version":"1.0.0","author":"Unknown","modified":"2025-10-04T14:11:06.7589516+03:00"},"category":"utilities","description":"Searches for ollama.exe in common locations.\r\n\r\n    .OUTPUTS\r\n    String. Path to ollama.exe or null if not found.\r\n    #\u003e\r\n\r\n    $possiblePaths = @(\r\n        \"ollama.exe\",\r\n        \"C:\\Program Files\\Ollama\\ollama.exe\",\r\n        \"C:\\Program Files (x86)\\Ollama\\ollama.exe\",\r\n        \"$env:USERPROFILE\\AppData\\Local\\Programs\\Ollama\\ollama.exe\",\r\n        \"$env:LOCALAPPDATA\\Programs\\Ollama\\ollama.exe\"\r\n    )\r\n\r\n    foreach ($path in $possiblePaths) {\r\n        if (Test-Path $path) {\r\n            Write-Log \"Found Ollama executable at: $path\" -Level \"INFO\" -Component \"ServerManager\"\r\n            return $path\r\n        }\r\n    }\r\n\r\n    Write-Log \"Ollama executable not found in standard locations\" -Level \"WARN\" -Component \"ServerManager\"\r\n    return $null\r\n}\r\n\r\nfunction Test-OllamaProcess {\r\n    \u003c#\r\n    .SYNOPSIS\r\n    Checks if Ollama server process is running.\r\n\r\n    .DESCRIPTION\r\n    Searches for ollama.exe process and returns status.\r\n\r\n    .OUTPUTS\r\n    PSCustomObject. Process status information.\r\n    #\u003e\r\n\r\n    try {\r\n        $processes = Get-Process -Name \"ollama\" -ErrorAction SilentlyContinue\r\n\r\n        if ($processes) {\r\n            $process = $processes[0]\r\n            return @{\r\n                IsRunning = $true\r\n                ProcessId = $process.Id\r\n                ProcessName = $process.ProcessName\r\n                StartTime = $process.StartTime\r\n                WorkingSet = $process.WorkingSet\r\n                CPU = $process.CPU\r\n            }\r\n        } else {\r\n            return @{\r\n                IsRunning = $false\r\n                ProcessId = $null\r\n                ProcessName = $null\r\n                StartTime = $null\r\n                WorkingSet = 0\r\n                CPU = 0\r\n            }\r\n        }\r\n    } catch {\r\n        Write-Log \"Error checking Ollama process: $($_.Exception.Message)\" -Level \"ERROR\" -Component \"ServerManager\"\r\n        return @{\r\n            IsRunning = $false\r\n            ProcessId = $null\r\n            ProcessName = $null\r\n            StartTime = $null\r\n            WorkingSet = 0\r\n            CPU = 0\r\n            Error = $_.Exception.Message\r\n        }\r\n    }\r\n}\r\n\r\nfunction Start-OllamaServer {\r\n    \u003c#\r\n    .SYNOPSIS\r\n    Starts the Ollama server with laptop optimization.\r\n\r\n    .DESCRIPTION\r\n    Launches Ollama server with optimized settings for laptop usage.","name":"ollama-server-manager","requiresAdmin":false,"entryPoint":"powershell"},{"parameters":[],"path":"tools/ollama-utils.ps1","tags":[],"metadata":{"created":"2025-12-08T13:55:22.5682903+02:00","sourceUrl":"https://github.com/devoptimizer/devoptimizer","version":"1.0.0","author":"Unknown","modified":"2025-12-08T13:55:22.5682903+02:00"},"category":"utilities","description":"No description available","name":"ollama-utils","requiresAdmin":false,"entryPoint":"powershell"},{"parameters":[],"path":"tools/run-ollama-all.ps1","tags":[],"metadata":{"created":"2025-10-04T12:00:02.5652960+03:00","sourceUrl":"https://github.com/d