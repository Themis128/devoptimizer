[],"path":"scripts/validate-system.ps1","tags":[],"metadata":{"created":"2026-09-06T01:26:40.2089893+03:00","sourceUrl":"https://github.com/devoptimizer/devoptimizer","version":"1.0.0","author":"Unknown","modified":"2026-09-06T01:26:40.2089893+03:00"},"category":"utilities","description":"No description available","name":"validate-system","requiresAdmin":false,"entryPoint":"powershell"},{"parameters":[{"description":"Relative path to the configuration file.\r\n\r\n    .OUTPUTS\r\n    String. Full path to the configuration file.\r\n    #\u003e\r\n    param(\r\n        [string]$ConfigPath = \"configs\\system-config.json\"\r\n    )\r\n\r\n    $scriptDir = if ($MyInvocation.MyCommand.Path) {\r\n        Split-Path -Parent $MyInvocation.MyCommand.Path\r\n    } else {\r\n        $PWD\r\n    }\r\n\r\n    # Try different path resolutions\r\n    $possiblePaths = @(\r\n        (Join-Path $scriptDir \"..\\$ConfigPath\"),\r\n        (Join-Path $PWD $ConfigPath),\r\n        \"D:\\DevOptimizer\\$ConfigPath\"\r\n    )\r\n\r\n    foreach ($path in $possiblePaths) {\r\n        if (Test-Path $path) {\r\n            Write-Log \"Found config file at: $path\" -Level \"DEBUG\" -Component \"Config\"\r\n            return $path\r\n        }\r\n    }\r\n\r\n    # If none found, return the first attempt\r\n    $firstPath = $possiblePaths[0]\r\n    Write-Log \"Config file not found, using: $firstPath\" -Level \"WARN\" -Component \"Config\"\r\n    return $firstPath\r\n}\r\n\r\nfunction Load-Configuration {\r\n    \u003c#\r\n    .SYNOPSIS\r\n    Loads the system configuration from JSON file.\r\n\r\n    .DESCRIPTION\r\n    Loads and validates the system configuration, storing it in a global variable.","name":"ConfigPath","type":"string","required":false},{"description":"Dot notation path to the configuration value.","name":"Path","type":"string","required":false},{"description":"Dot notation path to the configuration value.","name":"Path","type":"string","required":false},{"description":"Whether to save the changes to the configuration file.\r\n    #\u003e\r\n    param(\r\n        [Parameter(Mandatory=$true)]\r\n        [string]$Path,\r\n\r\n        [Parameter(Mandatory=$true)]\r\n        [object]$Value,\r\n\r\n        [bool]$SaveToFile = $true\r\n    )\r\n\r\n    try {\r\n        $config = Get-Configuration\r\n\r\n        # Split path by dots and navigate to the parent object\r\n        $pathParts = $Path -split \u0027\\.\u0027\r\n        $current = $config\r\n\r\n        # Navigate to the parent of the target property\r\n        for ($i = 0; $i -lt $pathParts.Length - 1; $i++) {\r\n            $part = $pathParts[$i]\r\n            if (-not $current.$part) {\r\n                $current.$part = @{}\r\n            }\r\n            $current = $current.$part\r\n        }\r\n\r\n        # Set the value\r\n        $lastPart = $pathParts[-1]\r\n        $current.$lastPart = $Value\r\n\r\n        # Update global config\r\n        $Global:DevOptimizerConfig = $config\r\n\r\n        Write-Log \"Configuration value updated: $Path = $Value\" -Level \"INFO\" -Component \"Config\"\r\n\r\n        if ($SaveToFile) {\r\n            Save-Configuration -Config $config\r\n        }\r\n\r\n    } catch {\r\n        Write-Error \"Failed to set configuration value \u0027$Path\u0027: $($_.Exception.Message)\"\r\n        Write-Log \"Failed to set configuration value \u0027$Path\u0027: $($_.Exception.Message)\" -Level \"ERROR\" -Component \"Config\"\r\n    }\r\n}\r\n\r\nfunction Save-Configuration {\r\n    \u003c#\r\n    .SYNOPSIS\r\n    Saves the configuration to the JSON file.\r\n\r\n    .DESCRIPTION\r\n    Writes the current configuration object to the configuration file.","name":"SaveToFile","type":"string","required":false},{"description":"Path to save the configuration file.\r\n    #\u003e\r\n    param(\r\n        [object]$Config = $null,\r\n        [string]$ConfigPath = \"configs\\system-config.json\"\r\n    )\r\n\r\n    try {\r\n        if ($Config -eq $null) {\r\n            $Config = Get-Configuration\r\n        }\r\n\r\n        $fullPath = Get-ConfigPath -ConfigPath $ConfigPath\r\n\r\n        # Ensure directory exists\r\n        $configDir = Split-Path -Parent $fullPath\r\n        if (-not (Test-Path $configDir)) {\r\n            New-Item -Path $configDir -ItemType Directory -Force | Out-Null\r\n        }\r\n\r\n        # Convert to JSON with proper formatting\r\n        $jsonContent = $Config | ConvertTo-Json -Depth 10\r\n\r\n        # Save to file\r\n        Set-Content -Path $fullPath -Value $jsonContent -Encoding UTF8\r\n\r\n        Write-Log \"Configuration saved to: $fullPath\" -Level \"INFO\" -Component \"Config\"\r\n\r\n    } catch {\r\n        Write-Error \"Failed to save configuration: $($_.Exception.Message)\"\r\n        Write-Log \"Failed to save configuration: $($_.Exception.Message)\" -Level \"ERROR\" -Component \"Config\"\r\n    }\r\n}\r\n\r\nfunction Test-Configuration {\r\n    \u003c#\r\n    .SYNOPSIS\r\n    Validates the configuration object structure.\r\n\r\n    .DESCRIPTION\r\n    Checks if the configuration object has the required properties and structure.","name":"ConfigPath","type":"string","required":false}],"path":"modules/config-loader.ps1","tags":[],"metadata":{"created":"2025-10-06T00:22:50.2358348+03:00","sourceUrl":"https://github.com/devoptimizer/devoptimizer","version":"1.0.0","author":"Unknown","modified":"2025-10-06T00:22:50.2358348+03:00"},"category":"utilities","description":"Resolves the configuration file path relative to the script location.","name":"config-loader","requiresAdmin":false,"entryPoint":"powershell"},{"parameters":[],"path":"modules/ollama-analytics.ps1","tags":[],"metadata":{"created":"2025-10-04T12:28:40.7707421+03:00","sourceUrl":"https://github.com/devoptimizer/devoptimizer","version":"1.0.0","author":"Unknown","modified":"2025-10-04T12:28:40.7707421+03:00"},"category":"utilities","description":"No description available","name":"ollama-analytics","requiresAdmin":false,"entryPoint":"powershell"},{"parameters":[{"description":"URL of the Ollama server.\r\n\r\n    .OUTPUTS\r\n    Array. List of available models.\r\n    #\u003e\r\n    param(\r\n        [string]$ServerUrl = $Global:OllamaServerUrl,\r\n        [int]$TimeoutSeconds = $Global:OllamaTimeout\r\n    )\r\n\r\n    try {\r\n        $response = Invoke-RestMethod -Uri \"$ServerUrl/api/tags\" -Method GET -TimeoutSec $TimeoutSeconds\r\n        $models = @()\r\n\r\n        if ($response.models) {\r\n            foreach ($model in $response.models) {\r\n                $models += @{\r\n                    Name = $model.name\r\n                    Size = $model.size\r\n                    ModifiedAt = $model.modified_at\r\n                    Family = $model.family\r\n                    Format = $model.format\r\n                    Families = $model.families\r\n                    ParameterSize = $model.parameter_size\r\n                    QuantizationLevel = $model.quantization_level\r\n                }\r\n            }\r\n        }\r\n\r\n        Write-Log \"Retrieved $($models.Count) models from Ollama server\" -Level \"INFO\" -Component \"OllamaREST\"\r\n        return $models\r\n\r\n    } catch {\r\n        Write-Log \"Failed to retrieve models from Ollama server: $($_.Exception.Message)\" -Level \"ERROR\" -Component \"OllamaREST\"\r\n        return @()\r\n    }\r\n}\r\n\r\nfunction Invoke-OllamaGenerate {\r\n    \u003c#\r\n    .SYNOPSIS\r\n    Generates text using Ollama REST API with streaming support.\r\n\r\n    .DESCRIPTION\r\n    Sends a generation request to Ollama and optionally streams the response.","name":"ServerUrl","type":"string","required":false},{"description":"Text prompt for generation.","name":"Prompt","type":"string","required":false},{"description":"Additional generation options.\r\n\r\n    .OUTPUTS\r\n    PSCustomObject. Generation response or streamed tokens.\r\n    #\u003e\r\n    param(\r\n        [Parameter(Mandatory=$true)]\r\n        [string]$Model,\r\n\r\n        [Parameter(Mandatory=$true)]\r\n        [string]$Prompt,\r\n\r\n        [bool]$Stream = $false,\r\n\r\n        [hashtable]$Options = @{},\r\n\r\n        [string]$ServerUrl = $Global:OllamaServerUrl,\r\n        [int]$TimeoutSeconds = $Global:OllamaTimeout,\r\n        [int]$MaxRetries = $Global:OllamaMaxRetries\r\n    )\r\n\r\n    # Input validation\r\n    if ([string]::IsNullOrWhiteSpace($Model)) {\r\n        throw \"Model name cannot be empty\"\r\n    }\r\n\r\n    if ([string]::IsNullOrWhiteSpace($Prompt)) {\r\n        throw \"Prompt cannot be empty\"\r\n    }\r\n\r\n    # Check prompt size (limit to 8000 chars for laptop optimization)\r\n    if ($Prompt.Length -gt 8000) {\r\n        Write-Log \"Prompt truncated from $($Prompt.Length) to 8000 characters for laptop optimization\" -Level \"WARN\" -Component \"OllamaREST\"\r\n        $Prompt = $Prompt.Substring(0, 8000)\r\n    }\r\n\r\n    $requestBody = @{\r\n        model = $Model\r\n        prompt = $Prompt\r\n        stream = $Stream\r\n    }\r\n\r\n    # Add options with laptop-optimized defaults\r\n    $defaultOptions = @{\r\n        temperature = 0.7\r\n        top_p = 0.9\r\n        top_k = 40\r\n        repeat_penalty = 1.1\r\n        num_predict = 512  # Limit for laptop\r\n        num_ctx = 2048     # Smaller context window\r\n    }\r\n\r\n    foreach ($key in $defaultOptions.Keys) {\r\n        if (-not $Options.ContainsKey($key)) {\r\n            $Options[$key] = $defaultOptions[$key]\r\n        }\r\n    }\r\n\r\n    $requestBody.options = $Options\r\n\r\n    $attempt = 0\r\n    $baseDelay = 0.5\r\n\r\n    while ($attempt -lt $MaxRetries) {\r\n        try {\r\n            $stopwatch = [System.Diagnostics.Stopwatch]::StartNew()\r\n\r\n            if ($Stream) {\r\n                # Handle streaming response\r\n                $response = Invoke-RestMethod -Uri \"$ServerUrl/api/generate\" -Method POST -Body ($requestBody | ConvertTo-Json) -ContentType \"application/json\" -TimeoutSec $TimeoutSeconds\r\n\r\n                # For streaming, we\u0027ll return the raw response\r\n                $stopwatch.Stop()\r\n                Write-Log \"Streaming generation completed for model \u0027$Model\u0027 in $($stopwatch.ElapsedMilliseconds)ms\" -Level \"INFO\" -Component \"OllamaREST\"\r\n                return $response\r\n            } else {\r\n                # Handle non-streaming response\r\n                $response = Invoke-RestMethod -Uri \"$ServerUrl/api/generate\" -Method POST -Body ($requestBody | ConvertTo-Json) -ContentType \"application/json\" -TimeoutSec $TimeoutSeconds\r\n\r\n                $stopwatch.Stop()\r\n\r\n                # Log metrics\r\n                $metrics = @{\r\n                    Model = $Model\r\n                    PromptLength = $Prompt.Length\r\n                    ResponseLength = if ($response.response) { $response.response.Length } else { 0 }\r\n                    Duration = $stopwatch.ElapsedMilliseconds\r\n                    Timestamp = Get-Date -Format \"yyyy-MM-dd HH:mm:ss\"\r\n                    Status = \"Success\"\r\n                }\r\n\r\n                Write-OllamaLog -Metrics $metrics\r\n                Write-Log \"Generation completed for model \u0027$Model\u0027 in $($stopwatch.ElapsedMilliseconds)ms\" -Level \"INFO\" -Component \"OllamaREST\"\r\n\r\n                return @{\r\n                    Response = $response.response\r\n                    Model = $Model\r\n                    CreatedAt = $response.created_at\r\n                    Done = $response.done\r\n                    Context = $response.context\r\n                    TotalDuration = $response.total_duration\r\n                    LoadDuration = $response.load_duration\r\n                    PromptEvalCount = $response.prompt_eval_count\r\n                    PromptEvalDuration = $response.prompt_eval_duration\r\n                    EvalCount = $response.eval_count\r\n                    EvalDuration = $response.eval_duration\r\n                }\r\n            }\r\n\r\n        } catch {\r\n            $attempt++\r\n            $delay = $baseDelay * [Math]::Pow(2, $attempt - 1)\r\n\r\n            Write-Log \"Generation attempt $attempt failed for model \u0027$Model\u0027: $($_.Exception.Message)\" -Level \"WARN\" -Component \"OllamaREST\"\r\n\r\n            if ($attempt -ge $MaxRetries) {\r\n                # Log failure metrics\r\n                $metrics = @{\r\n                    Model = $Model\r\n                    PromptLength = $Prompt.Length\r\n                    ResponseLength = 0\r\n                    Duration = 0\r\n                    Timestamp = Get-Date -Format \"yyyy-MM-dd HH:mm:ss\"\r\n                    Status = \"Failed\"\r\n                    Error = $_.Exception.Message\r\n                }\r\n\r\n                Write-OllamaLog -Metrics $metrics\r\n                throw \"Failed to generate after $MaxRetries attempts: $($_.Exception.Message)\"\r\n            }\r\n\r\n            Write-Log \"Retrying in $delay seconds...\" -Level \"INFO\" -Component \"OllamaREST\"\r\n            Start-Sleep -Seconds $delay\r\n        }\r\n    }\r\n}\r\n\r\nfunction Invoke-OllamaEmbeddings {\r\n    \u003c#\r\n    .SYNOPSIS\r\n    Generates embeddings using Ollama REST API.\r\n\r\n    .DESCRIPTION\r\n    Creates embeddings for the given text prompt.","name":"Options","type":"string","required":false},{"description":"Text to create embeddings for.\r\n\r\n    .OUTPUTS\r\n    Array. Embedding vector.\r\n    #\u003e\r\n    param(\r\n        [Parameter(Mandatory=$true)]\r\n        [string]$Model,\r\n\r\n        [Parameter(Mandatory=$true)]\r\n        [string]$Prompt,\r\n\r\n        [string]$ServerUrl = $Global:OllamaServerUrl,\r\n        [int]$TimeoutSeconds = $Global:OllamaTimeout\r\n    )\r\n\r\n    try {\r\n        $requestBody = @{\r\n            model = $Model\r\n            prompt = $Prompt\r\n        }\r\n\r\n        $response = Invoke-RestMethod -Uri \"$ServerUrl/api/embeddings\" -Method POST -Body ($requestBody | ConvertTo-Json) -ContentType \"application/json\" -TimeoutSec $TimeoutSeconds\r\n\r\n        Write-Log \"Generated embeddings for model \u0027$Model\u0027 (vector length: $($response.embedding.Count))\" -Level \"INFO\" -Component \"OllamaREST\"\r\n\r\n        return @{\r\n            Embedding = $response.embedding\r\n            Model = $Model\r\n        }\r\n\r\n    } catch {\r\n        Write-Log \"Failed to generate embeddings for model \u0027$Model\u0027: $($_.Exception.Message)\" -Level \"ERROR\" -Component \"OllamaREST\"\r\n        throw \"Failed to generate embeddings: $($_.Exception.Message)\"\r\n    }\r\n}\r\n\r\nfunction Find-OpenPort {\r\n    \u003c#\r\n    .SYNOPSIS\r\n    Finds an open port starting from a base port.\r\n\r\n    .DESCRIPTION\r\n    Scans ports starting from the base port to find an available one.","name":"Prompt","type":"string","required":false},{"description":"Maximum number of ports to check.\r\n\r\n    .OUTPUTS\r\n    Integer. First available port number, or null if none found.\r\n    #\u003e\r\n    param(\r\n        [int]$BasePort = 11434,\r\n        [int]$MaxAttempts = 10\r\n    )\r\n\r\n    for ($i = 0; $i -lt $MaxAttempts; $i++) {\r\n        $port = $BasePort + $i\r\n        try {\r\n            $listener = [System.Net.Sockets.TcpListener]::new([System.Net.IPAddress]::Any, $port)\r\n            $listener.Start()\r\n            $listener.Stop()\r\n            Write-Log \"Found open port: $port\" -Level \"INFO\" -Component \"OllamaREST\"\r\n            return $port\r\n        } catch {\r\n            # Port is in use, try next one\r\n            continue\r\n        }\r\n    }\r\n\r\n    Write-Log \"No open ports found in range $BasePort to $($BasePort + $MaxAttempts - 1)\" -Level \"WARN\" -Component \"OllamaREST\"\r\n    return $null\r\n}\r\n\r\nfunction Write-OllamaLog {\r\n    \u003c#\r\n    .SYNOPSIS\r\n    Writes structured logs for Ollama operations.\r\n\r\n    .DESCRIPTION\r\n    Creates JSONL logs for monitoring and analysis.","name":"MaxAttempts","type":"string","required":false}],"path":"modules/ollama-rest.ps1","tags":[],"metadata":{"created":"2025-10-04T12:00:02.5572125+03:00","sourceUrl":"https://github.com/devoptimizer/devoptimizer","version":"1.0.0","author":"Unknown","modified":"2025-10-04T12:00:02.5572125+03:00"},"category":"utilities","description":"Performs multiple health checks to ensure the Ollama server is working properly.\r\n\r\n    .OUTPUTS\r\n    PSCustomObject. Health status with details.\r\n    #\u003e\r\n    param(\r\n        [string]$ServerUrl = $Global:OllamaServerUrl,\r\n        [int]$TimeoutSeconds = $Global:OllamaTimeout\r\n    )\r\n\r\n    $healthResult = @{\r\n        IsHealthy = $false\r\n        ServerUrl = $ServerUrl\r\n        Checks = @{\r\n            ApiReachable = $false\r\n            ModelsAvailable = $false\r\n            GenerateWorking = $false\r\n            EmbeddingsWorking = $false\r\n        }\r\n        Errors = @()\r\n        Models = @()\r\n        ResponseTime = 0\r\n    }\r\n\r\n    try {\r\n        $stopwatch = [System.Diagnostics.Stopwatch]::StartNew()\r\n\r\n        # Check 1: API reachable\r\n        try {\r\n            $response = Invoke-RestMethod -Uri \"$ServerUrl/api/tags\" -Method GET -TimeoutSec $TimeoutSeconds\r\n            $healthResult.Checks.ApiReachable = $true\r\n            if ($response.models) {\r\n                $healthResult.Models = $response.models\r\n                $healthResult.Checks.ModelsAvailable = $healthResult.Models.Count -gt 0\r\n            }\r\n        } catch {\r\n            $healthResult.Errors += \"API reachable check failed: $($_.Exception.Message)\"\r\n        }\r\n\r\n        # Check 2: Generate endpoint working (1-token probe)\r\n        if ($healthResult.Checks.ApiReachable) {\r\n            try {\r\n                $testPrompt = @{\r\n                    model = if ($healthResult.Models.Count -gt 0) { $healthResult.Models[0].name } else { \"llama2:7b\" }\r\n                    prompt = \"ok\"\r\n                    stream = $false\r\n                    options = @{\r\n                        num_predict = 1\r\n                        temperature = 0\r\n                    }\r\n                }\r\n\r\n                $generateResponse = Invoke-RestMethod -Uri \"$ServerUrl/api/generate\" -Method POST -Body ($testPrompt | ConvertTo-Json) -ContentType \"application/json\" -TimeoutSec $TimeoutSeconds\r\n                if ($generateResponse.response) {\r\n                    $healthResult.Checks.GenerateWorking = $true\r\n                }\r\n            } catch {\r\n                $healthResult.Errors += \"Generate check failed: $($_.Exception.Message)\"\r\n            }\r\n        }\r\n\r\n        # Check 3: Embeddings endpoint working\r\n        if ($healthResult.Checks.ApiReachable) {\r\n            try {\r\n                $embeddingRequest = @{\r\n                    model = if ($healthResult.Models.Count -gt 0) { $healthResult.Models[0].name } else { \"llama2:7b\" }\r\n                    prompt = \"test\"\r\n                }\r\n\r\n                $embeddingResponse = Invoke-RestMethod -Uri \"$ServerUrl/api/embeddings\" -Method POST -Body ($embeddingRequest | ConvertTo-Json) -ContentType \"application/json\" -TimeoutSec $TimeoutSeconds\r\n                if ($embeddingResponse.embedding -and $embeddingResponse.embedding.Count -gt 0) {\r\n                    $healthResult.Checks.EmbeddingsWorking = $true\r\n                }\r\n            } catch {\r\n                $healthResult.Errors += \"Embeddings check failed: $($_.Exception.Message)\"\r\n            }\r\n        }\r\n\r\n        $stopwatch.Stop()\r\n        $healthResult.ResponseTime = $stopwatch.ElapsedMilliseconds\r\n\r\n        # Overall health assessment\r\n        $healthResult.IsHealthy = $healthResult.Checks.ApiReachable -and $healthResult.Checks.ModelsAvailable\r\n\r\n        Write-Log \"Ollama server health check completed in $($healthResult.ResponseTime)ms\" -Level \"INFO\" -Component \"OllamaREST\"\r\n        if ($healthResult.IsHealthy) {\r\n            Write-Log \"Server is healthy with $($healthResult.Models.Count) models available\" -Level \"INFO\" -Component \"OllamaREST\"\r\n        } else {\r\n            Write-Log \"Server health issues detected: $($healthResult.Errors -join \u0027; \u0027)\" -Level \"WARN\" -Component \"OllamaREST\"\r\n        }\r\n\r\n        return $healthResult\r\n\r\n    } catch {\r\n        $healthResult.Errors += \"Health check failed: $($_.Exception.Message)\"\r\n        Write-Log \"Ollama server health check failed: $($_.Exception.Message)\" -Level \"ERROR\" -Component \"OllamaREST\"\r\n        return $healthResult\r\n    }\r\n}\r\n\r\nfunction Get-OllamaModels {\r\n    \u003c#\r\n    .SYNOPSIS\r\n    Gets the list of available Ollama models via REST API.\r\n\r\n    .DESCRIPTION\r\n    Retrieves all available models from the Ollama server.","name":"ollama-rest","requiresAdmin":false,"entryPoint":"powershell"},{"parameters":[],"path":"tools/admin-privilege-manager.ps1","tags":[],"metadata":{"created":"2025-10-04T10:12:09.1558632+03:00","sourceUrl":"https://github.com/devoptimizer/devoptimizer","version":"1.0.0","author":"Unknown","modified":"2025-10-04T10:12:09.1558632+03:00"},"category":"utilities","description":"No description available","name":"admin-privilege-manager","requiresAdmin":false,"entryPoint":"powershell"},{"parameters":[],"path":"tools/create-desktop-shortcut.ps1","tags":[],"metadata":{"created":"2025-10-04T12:22:02.9484195+03:00","sourceUrl":"https://github.com/devoptimizer/devoptimizer","version":"1.0.0","author":"Unknown","modified":"2025-10-04T12:22:02.9484195+03:00"},"category":"utilities","description":"No description available","name":"create-desktop-shortcut","requiresAdmin":false,"entryPoint":"powershell"},{"parameters":[],"path":"tools/create-dual-versions.ps1","tags":[],"metadata":{"created":"2025-10-04T10:12:23.4901669+03:00","sourceUrl":"https://gith