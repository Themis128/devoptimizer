{
  "name": "nuxt4-optimized-app",
  "version": "1.0.0",
  "description": "Optimized Nuxt 4 application with latest 2024/2025 best practices",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "node .output/server/index.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "analyze": "ANALYZE=true nuxt build",
    "cleanup": "nuxt cleanup"
  },
  "dependencies": {
    "@nuxt/image": "^1.8.1",
    "@nuxtjs/critters": "^0.7.2",
    "@nuxtjs/seo": "^2.0.0-rc.23",
    "@nuxtjs/tailwindcss": "^6.12.1",
    "@nuxtjs/web-vitals": "^0.2.7",
    "@pinia/nuxt": "^0.5.5",
    "@vite-pwa/nuxt": "^0.10.0",
    "@vueuse/nuxt": "^11.1.0",
    "nuxt": "^3.14.159",
    "pinia": "^2.2.6",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@nuxt/content": "^3.17.0",
    "@nuxt/devtools": "^1.6.0",
    "@nuxt/eslint": "^0.7.4",
    "@nuxt/test-utils": "^3.14.4",
    "@types/node": "^22.9.0",
    "@vitest/ui": "^3.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.14.0",
    "happy-dom": "^15.11.6",
    "playwright-core": "^1.48.2",
    "sass": "^1.80.6",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^3.2.0"
  },
  "resolutions": {
    "vue": "^3.5.12"
  }
}
