<Window x:Class="DevOptimizer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:DevOptimizer.App.Views"
        xmlns:converters="clr-namespace:DevOptimizer.App.Views.Converters"
        mc:Ignorable="d"
        Title="DevOptimizer"
        Width="1280"
        Height="820"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <!-- Ctrl+F: Focus search box -->
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}" />
        <!-- Enter: Run selected command -->
        <KeyBinding Key="Enter" Command="{Binding RunCommand}" />
        <!-- Esc: Clear search or cancel operation -->
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
        <!-- Ctrl+L: Clear output -->
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ClearOutputCommand}" />
        <!-- F1: Show help -->
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Converter for search scope toggle button -->
        <converters:BoolToSearchScopeConverter x:Key="BoolToSearchScopeConverter" />
        <!-- Converter for search text visibility -->
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <!-- Converter for search text highlighting -->
        <converters:SearchHighlightConverter x:Key="SearchHighlightConverter" />
        <!-- Converter for placeholder visibility (show when text is empty) -->
        <converters:IsNullOrEmptyToVisibilityConverter x:Key="IsNullOrEmptyToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar: search text drives MainViewModel.SearchText live (Task 2 semantics). -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Foreground="#8A8A98" />
            <Button DockPanel.Dock="Right"
                    Content="{Binding SearchWithinCategory, 
                                    Converter={StaticResource BoolToSearchScopeConverter}}"
                    ToolTip="Toggle search scope: Current category or All categories"
                    Width="24"
                    Height="24"
                    Margin="4,0,0,0"
                    Command="{Binding ToggleSearchScopeCommand}"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                    BorderThickness="0"
                    Background="Transparent"
                    Foreground="{Binding StatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="0">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="3"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchTextBox"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             Padding="6,4"
                             Background="Transparent"
                             Foreground="{Binding StatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                             BorderThickness="0">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock Text="Search commands..."
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Foreground="#6A6A78"
                               FontSize="14"
                               Visibility="{Binding SearchText, Converter={StaticResource IsNullOrEmptyToVisibilityConverter}}" />
                </Grid>
                <Button Grid.Column="1"
                        Content="✕"
                        Visibility="{Binding SearchText, Converter={StaticResource StringToVisibilityConverter}}"
                        ToolTip="Clear search"
                        Width="20"
                        Height="20"
                        Margin="2,0,0,0"
                        Command="{Binding ClearSearchCommand}"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="#8A8A98"
                        Padding="0"
                        FontWeight="Bold"/>
            </Grid>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: All + categories with live counts. -->
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}"
                     DisplayMemberPath="Display"
                     Margin="0,0,8,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

            <!-- Command list: virtualized (349 commands). -->
            <ListBox Grid.Column="1"
                     ItemsSource="{Binding FilteredCommands}"
                     SelectedItem="{Binding SelectedCommand}"
                     Margin="0,0,8,0"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="SemiBold">
                                    <TextBlock.Text>
                                        <Binding Path="HighlightedName" Converter="{StaticResource SearchHighlightConverter}" />
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Foreground="#8A8A98" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <Binding Path="HighlightedDescription" Converter="{StaticResource SearchHighlightConverter}" />
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#4A3B2A"
                                    CornerRadius="3"
                                    Padding="4,1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="ADMIN" FontSize="10" Foreground="#D7BA7D" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Detail panel + run controls + output pane. -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="{Binding SelectedCommand.Name}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#4EC9B0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedCommand.CategoryAndEntry}" Foreground="#569CD6" />
                    <Border Background="#4A3B2A"
                            CornerRadius="3"
                            Padding="4,1"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0"
                            Visibility="{Binding ShowElevatedButton, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <TextBlock Text="Requires administrator privileges" FontSize="11" Foreground="#D7BA7D" />
                    </Border>
                    <TextBlock Text="{Binding SelectedCommand.Description}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="SCRIPT PATH" Foreground="#8A8A98" FontSize="10.5" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding SelectedCommand.Path}" Foreground="#9CDCFE" TextWrapping="Wrap" />
                    <TextBlock Text="TAGS" Foreground="#8A8A98" FontSize="10.5" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding SelectedCommand.TagsDisplay}" Foreground="#9CDCFE" TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,6">
                    <StackPanel>
                        <TextBlock Text="PARAMETERS"
                                   Foreground="#8A8A98"
                                   FontSize="10.5"
                                   Margin="0,0,0,4"
                                   Visibility="{Binding HasParameters, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                        <ItemsControl ItemsSource="{Binding ParameterInputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Signature}" ToolTip="{Binding Description}" />
                                        <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="2" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Progress Indicator -->
                <Grid Grid.Row="2" Margin="0,4,0,4" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Value="{Binding ProgressPercentage}" Height="20" Margin="0,0,8,0"/>
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Width="80"
                            Height="24"
                            VerticalAlignment="Center"/>
                </Grid>

                <UniformGrid Grid.Row="3" Columns="3" Margin="0,4,0,4">
                    <Button Command="{Binding RunCommand}" Content="Run" Padding="10,4" Margin="0,0,4,0" />
                    <Button Command="{Binding RunElevatedCommand}"
                            Content="Elevated"
                            Padding="10,4"
                            Margin="0,0,4,0"
                            Visibility="{Binding ShowElevatedButton, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                    <CheckBox Content="Dry run"
                              IsChecked="{Binding DryRun, Mode=TwoWay}"
                              VerticalContentAlignment="Center"
                              Margin="8,0,0,0" />
                </UniformGrid>

                <TextBox Grid.Row="3"
                         Text="{Binding OutputText, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         Height="180"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         Background="#1E1E1E"
                         Foreground="#D4D4D4" />
            </Grid>
        </Grid>
        
        <!-- Toast container positioned at bottom-right -->
        <Canvas x:Name="ToastContainer"
                Grid.Row="1" 
                Grid.ColumnSpan="3" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom"/>
    </Grid>
</Window>