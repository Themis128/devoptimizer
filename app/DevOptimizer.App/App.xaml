<Application x:Class="DevOptimizer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- No StartupUri: the MainWindow is resolved from the DI host in App.OnStartup. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design (Fluent-compatible) theme -->
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Teal" SecondaryColor="Lime" />
                
                <!-- Custom Fluent Design resources -->
                <ResourceDictionary>
                    <!-- Fluent Design Color Palette - Dark Theme -->
                    <SolidColorBrush x:Key="FluentBackgroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="FluentSurfaceBrush" Color="#252526" />
                    <SolidColorBrush x:Key="FluentSurfaceVariantBrush" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="FluentPrimaryBrush" Color="#4EC9B0" />
                    <SolidColorBrush x:Key="FluentPrimaryVariantBrush" Color="#3DB89F" />
                    <SolidColorBrush x:Key="FluentOnPrimaryBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="FluentSecondaryBrush" Color="#DCDCAA" />
                    <SolidColorBrush x:Key="FluentOnSecondaryBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="FluentErrorBrush" Color="#F14C4C" />
                    <SolidColorBrush x:Key="FluentOnErrorBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FluentOutlineBrush" Color="#3E3E42" />
                    <SolidColorBrush x:Key="FluentOutlineVariantBrush" Color="#4A4A4A" />
                    <SolidColorBrush x:Key="FluentOnBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FluentOnSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FluentOnSurfaceVariantBrush" Color="#CCCCCC" />
                    
                    <!-- Fluent Design Typography -->
                    <FontFamily x:Key="FluentFontFamily">Segoe UI Variable, Segoe UI, system-ui</FontFamily>
                    <FontFamily x:Key="FluentFontFamilyMonospace">Cascadia Code, Consolas, monospace</FontFamily>
                    
                    <Double x:Key="FluentFontSizeCaption">12</Double>
                    <Double x:Key="FluentFontSizeBody">14</Double>
                    <Double x:Key="FluentFontSizeBodyLarge">16</Double>
                    <Double x:Key="FluentFontSizeTitle">20</Double>
                    <Double x:Key="FluentFontSizeTitleLarge">28</Double>
                    <Double x:Key="FluentFontSizeDisplay">36</Double>
                    <Double x:Key="FluentFontSizeDisplayLarge">48</Double>
                    
                    <FontWeight x:Key="FluentFontWeightLight">300</FontWeight>
                    <FontWeight x:Key="FluentFontWeightRegular">400</FontWeight>
                    <FontWeight x:Key="FluentFontWeightMedium">500</FontWeight>
                    <FontWeight x:Key="FluentFontWeightSemiBold">600</FontWeight>
                    <FontWeight x:Key="FluentFontWeightBold">700</FontWeight>
                    
                    <!-- Fluent Design Spacing -->
                    <Double x:Key="FluentSpacingXS">4</Double>
                    <Double x:Key="FluentSpacingS">8</Double>
                    <Double x:Key="FluentSpacingM">12</Double>
                    <Double x:Key="FluentSpacingL">16</Double>
                    <Double x:Key="FluentSpacingXL">24</Double>
                    <Double x:Key="FluentSpacingXXL">32</Double>
                    
                    <!-- Fluent Design Corner Radius -->
                    <CornerRadius x:Key="FluentCornerRadiusS">4</CornerRadius>
                    <CornerRadius x:Key="FluentCornerRadiusM">8</CornerRadius>
                    <CornerRadius x:Key="FluentCornerRadiusL">12</CornerRadius>
                    <CornerRadius x:Key="FluentCornerRadiusXL">16</CornerRadius>
                    <CornerRadius x:Key="FluentCornerRadiusFull">9999</CornerRadius>
                    
                    <!-- Fluent Design Elevation/Shadows -->
                    <DropShadowEffect x:Key="FluentElevation1" ShadowDepth="1" BlurRadius="3" Opacity="0.1" Color="Black" Direction="270" />
                    <DropShadowEffect x:Key="FluentElevation2" ShadowDepth="2" BlurRadius="6" Opacity="0.15" Color="Black" Direction="270" />
                    <DropShadowEffect x:Key="FluentElevation3" ShadowDepth="4" BlurRadius="12" Opacity="0.2" Color="Black" Direction="270" />
                    <DropShadowEffect x:Key="FluentElevation4" ShadowDepth="8" BlurRadius="24" Opacity="0.25" Color="Black" Direction="270" />
                    
                    <!-- Fluent Design Animation Durations -->
                    <Duration x:Key="FluentDurationFast">0:0:0.1</Duration>
                    <Duration x:Key="FluentDurationNormal">0:0:0.2</Duration>
                    <Duration x:Key="FluentDurationSlow">0:0:0.3</Duration>
                    
                    <!-- Fluent Design Control Styles -->
                    <Style x:Key="FluentButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Setter Property="Background" Value="{StaticResource FluentPrimaryBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource FluentOnPrimaryBrush}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="16,8" />
                        <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                        <Setter Property="FontSize" Value="{StaticResource FluentFontSizeBody}" />
                        <Setter Property="FontWeight" Value="{StaticResource FluentFontWeightMedium}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Effect" Value="{StaticResource FluentElevation1}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource FluentPrimaryVariantBrush}" />
                                <Setter Property="Effect" Value="{StaticResource FluentElevation2}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Effect" Value="{StaticResource FluentElevation1}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{StaticResource FluentOutlineBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource FluentOnSurfaceVariantBrush}" />
                                <Setter Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    
                    <Style x:Key="FluentButtonOutlined" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                        <Setter Property="BorderBrush" Value="{StaticResource FluentOutlineBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource FluentPrimaryBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="16,8" />
                        <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                        <Setter Property="FontSize" Value="{StaticResource FluentFontSizeBody}" />
                        <Setter Property="FontWeight" Value="{StaticResource FluentFontWeightMedium}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource FluentPrimaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource FluentOnPrimaryBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource FluentPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="BorderBrush" Value="{StaticResource FluentOutlineVariantBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource FluentOnSurfaceVariantBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    
                    <Style x:Key="FluentButtonText" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                        <Setter Property="Foreground" Value="{StaticResource FluentPrimaryBrush}" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                        <Setter Property="FontSize" Value="{StaticResource FluentFontSizeBody}" />
                        <Setter Property="FontWeight" Value="{StaticResource FluentFontWeightMedium}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource FluentSurfaceVariantBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource FluentOnSurfaceVariantBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    
                    <Style x:Key="FluentTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                        <Setter Property="Background" Value="{StaticResource FluentSurfaceBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource FluentOnSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource FluentOutlineBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                        <Setter Property="FontSize" Value="{StaticResource FluentFontSizeBody}" />
                        <Setter Property="CaretBrush" Value="{StaticResource FluentPrimaryBrush}" />
                        <Setter Property="SelectionBrush" Value="{StaticResource FluentPrimaryBrush}" />
                        <Setter Property="SelectionTextBrush" Value="{StaticResource FluentOnPrimaryBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource FluentPrimaryBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Effect" Value="{StaticResource FluentElevation1}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{StaticResource FluentSurfaceVariantBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource FluentOnSurfaceVariantBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource FluentOutlineVariantBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    
                    <Style x:Key="FluentComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
                        <Setter Property="Background" Value="{StaticResource FluentSurfaceBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource FluentOnSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource FluentOutlineBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                        <Setter Property="FontSize" Value="{StaticResource FluentFontSizeBody}" />
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource FluentPrimaryBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{StaticResource FluentSurfaceVariantBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource FluentOnSurfaceVariantBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource FluentOutlineVariantBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    
                    <Style x:Key="FluentListBox" TargetType="ListBox" BasedOn="{StaticResource MaterialDesignListBox}">
                        <Setter Property="Background" Value="{StaticResource FluentBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource FluentOutlineBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                        <Setter Property="FontSize" Value="{StaticResource FluentFontSizeBody}" />
                    </Style>
                    
                    <Style x:Key="FluentListBoxItem" TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                        <Setter Property="FontSize" Value="{StaticResource FluentFontSizeBody}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource FluentPrimaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource FluentOnPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource FluentSurfaceVariantBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    
                    <Style x:Key="FluentCard" TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource FluentSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource FluentOutlineBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="{StaticResource FluentCornerRadiusM}" />
                        <Setter Property="Effect" Value="{StaticResource FluentElevation1}" />
                        <Setter Property="Padding" Value="{StaticResource FluentSpacingL}" />
                    </Style>
                    
                    <Style x:Key="FluentCardElevated" TargetType="Border" BasedOn="{StaticResource FluentCard}">
                        <Setter Property="Effect" Value="{StaticResource FluentElevation2}" />
                    </Style>
                    
                    <Style x:Key="FluentSeparator" TargetType="Separator">
                        <Setter Property="Background" Value="{StaticResource FluentOutlineBrush}" />
                        <Setter Property="Margin" Value="0,{StaticResource FluentSpacingM}" />
                    </Style>
                    
                    <!-- ScrollViewer styling -->
                    <Style x:Key="FluentScrollViewer" TargetType="ScrollViewer">
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ScrollContentPresenter Grid.Column="0" />
                                        <ScrollBar Grid.Column="1" 
                                                   Orientation="Vertical" 
                                                   Visibility="{TemplateBinding VerticalScrollBarVisibility}"
                                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                                   Maximum="{TemplateBinding ScrollableHeight}"
                                                   Background="Transparent"
                                                   Width="8" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    
                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Width" Value="8" />
                        <Setter Property="MinWidth" Value="8" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Track Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.LineUpCommand" Background="Transparent" BorderThickness="0" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.LineDownCommand" Background="Transparent" BorderThickness="0" />
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Background="{StaticResource FluentOutlineBrush}" 
                                                   Width="8" 
                                                   Margin="0,2"
                                                   Cursor="Hand">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="4"
                                                                SnapsToDevicePixels="True" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    
                    <!-- ToggleButton for theme switch -->
                    <Style x:Key="FluentToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignActionToggleButton}">
                        <Setter Property="Background" Value="{StaticResource FluentSurfaceBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource FluentOnSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource FluentOutlineBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                        <Setter Property="FontSize" Value="{StaticResource FluentFontSizeBody}" />
                        <Setter Property="FontWeight" Value="{StaticResource FluentFontWeightMedium}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Effect" Value="{StaticResource FluentElevation1}" />
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource FluentPrimaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource FluentOnPrimaryBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource FluentPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Effect" Value="{StaticResource FluentElevation2}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{StaticResource FluentSurfaceVariantBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource FluentOnSurfaceVariantBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource FluentOutlineVariantBrush}" />
                                <Setter Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
