{
  "hooks": {
    "preCommand": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -Command \"Write-Host '[Devin Hook] Pre-command executed'\""
          }
        ]
      }
    ],
    "postCommand": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -Command \"Write-Host '[Devin Hook] Post-command executed'\""
          }
        ]
      }
    ],
    "preToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -Command \"Write-Host '[Devin Hook] Pre-tool use'\""
          }
        ]
      }
    ],
    "postToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -Command \"Write-Host '[Devin Hook] Post-tool use'\""
          }
        ]
      }
    ]
  }
}